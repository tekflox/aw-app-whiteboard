{
  "layout": "stack",
  "regions": [
    {
      "id": "canvas",
      "widgets": [
        {
          "type": "iframe",
          "title": "Whiteboard",
          "src": "/api/apps/whiteboard/view/main"
        }
      ]
    },
    {
      "id": "actions",
      "widgets": [
        {
          "type": "button",
          "label": "Export PNG",
          "action": { "call": "POST /api/apps/whiteboard/boards/main/screenshot" }
        },
        {
          "type": "button",
          "label": "Save to presentation",
          "action": { "call": "POST /api/apps/whiteboard/boards/main/save_presentation" }
        }
      ]
    }
  ]
}
