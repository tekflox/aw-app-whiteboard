{
  "manifest_version": 1,
  "id": "whiteboard",
  "name": "Whiteboard",
  "version": "0.14.0",
  "description": "Persistent, live-synced HTML canvas \u2014 set/patch content, broadcast changes over a WebSocket to every open viewer, round-trip with a presentation. Migrated from the aw monolith (src/api/routes/whiteboard.py + whiteboard_manager.py + WhiteboardWindow.jsx).",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "medium",
    "memory": "medium",
    "disk": "medium"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "whiteboard_app.plugin:WhiteboardAppPlugin",
    "pip_requires": [
      "playwright>=1.40",
      "httpx>=0.24"
    ]
  },
  "permissions": [
    "routes:register",
    "db:own-tables",
    "ui:code",
    "ui:slots:core.nav.workspace"
  ],
  "contributes": {
    "routes": [
      {
        "prefix": "/api/apps/whiteboard"
      }
    ],
    "windows": [
      {
        "id": "whiteboard.main",
        "title": "Whiteboard",
        "icon": "square",
        "body": {
          "type": "component"
        }
      }
    ],
    "frontend": {
      "mode": "component",
      "bundle": "ui/dist/whiteboard.js",
      "slots": [
        "core.nav.workspace",
        "core.window.body:whiteboard.main"
      ]
    },
    "mcp": {
      "reload_on_save": true,
      "provides": [
        "whiteboard_show_html",
        "whiteboard_get",
        "whiteboard_list",
        "whiteboard_delete",
        "whiteboard_exec_js",
        "whiteboard_point",
        "whiteboard_close",
        "whiteboard_status",
        "whiteboard_screenshot",
        "whiteboard_browse",
        "whiteboard_click",
        "whiteboard_type",
        "whiteboard_key",
        "whiteboard_scroll",
        "whiteboard_eval",
        "whiteboard_browser_close",
        "whiteboard_load_presentation",
        "whiteboard_save_presentation"
      ]
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "default_board_id": {
        "type": "string",
        "default": "main",
        "description": "Board id the nav entry opens by default."
      },
      "presentation_api_base": {
        "type": "string",
        "description": "Base URL of a presentation API to round-trip boards with (load_presentation/save_presentation). aw-workspace does not ship one yet \u2014 see README. Leave unset to disable the round-trip (returns 501)."
      }
    },
    "required": []
  },
  "dependencies": {},
  "migrations": {}
}
